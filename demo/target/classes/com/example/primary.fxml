<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController" styleClass="app">
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" styleClass="title-bar" prefHeight="30" minHeight="30" maxHeight="30">
                <HBox fx:id="titleDrag" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="title-drag"><Label text="WORD-WRECK!  /  A LITTLE ADVENTURE AT SEA" styleClass="eyebrow"/></HBox>
                <Button fx:id="maximizeButton" text="Maximize" onAction="#maximize" styleClass="window-button"/>
                <Button text="Close ×" onAction="#closeApp" styleClass="window-button,close-button"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="nav" prefHeight="62" minHeight="62" maxHeight="62">
                <Label text="W / W" styleClass="brand-icon"/>
                <VBox spacing="2"><Label text="WORD-WRECK!" styleClass="brand"/><Label text="GUESS WELL. SAIL FAR." styleClass="eyebrow"/></VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="modeLabel" styleClass="badge"/><Button text="Settings" onAction="#showSettings" styleClass="quiet-button"/>
                <Button text="How to play" onAction="#showHelp" styleClass="quiet-button"/>
                <Button text="Home" onAction="#showHome" styleClass="quiet-button"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane>
            <VBox fx:id="homePane" alignment="CENTER" spacing="16" styleClass="home">
                <Label text="20 VOYAGES  /  2 RAFTS  /  1 ANCHOR" styleClass="badge"/>
                <Label text="Keep your words afloat." styleClass="hero-title"/>
                <Label text="A little wordplay. A little danger. A whole ocean of adventure." styleClass="subtitle"/>
                <Pane fx:id="heroArt" prefHeight="190" minHeight="190" maxHeight="190" maxWidth="700" styleClass="ocean"/>
                <HBox alignment="CENTER" spacing="14">
                    <VBox spacing="8" styleClass="feature-card"><Label text="01  GUESS" styleClass="card-title"/><Label text="Type right onto the raft.&#10;Five chances to save each word." styleClass="muted"/></VBox>
                    <VBox spacing="8" styleClass="feature-card"><Label text="02  PROTECT" styleClass="card-title"/><Label text="Secure the shared anchor.&#10;Keep the junction from sinking." styleClass="muted"/></VBox>
                    <VBox spacing="8" styleClass="feature-card"><Label text="03  ASK THE CAPTAIN" styleClass="card-title"/><Label text="Stuck at sea? Get a free hint&#10;with a little pirate personality." styleClass="muted"/></VBox>
                </HBox>
                <HBox alignment="CENTER" spacing="12"><ComboBox fx:id="homeLevel" prefWidth="145"/><Button text="Set sail →" onAction="#startGame" styleClass="primary-button"/><Button fx:id="resumeButton" text="Resume voyage" onAction="#resumeGame" disable="true" styleClass="quiet-button"/></HBox>
                <Label fx:id="homeStatus" styleClass="muted"/>
            </VBox>
            <VBox fx:id="gamePane" spacing="10" styleClass="game" visible="false" managed="false">
                <HBox alignment="CENTER_LEFT" spacing="12" prefHeight="38" minHeight="38" maxHeight="38">
                    <VBox spacing="2"><Label fx:id="levelTitle" styleClass="section-title"/><Label fx:id="phaseLabel" styleClass="muted"/></VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="hintButton" text="Captain's hint ✦" onAction="#showHint" styleClass="primary-button"/>
                    <Button text="Restart" onAction="#restartLevel" styleClass="quiet-button"/>
                </HBox>
                <HBox spacing="16" alignment="TOP_LEFT">
                    <VBox spacing="10" prefWidth="800" HBox.hgrow="ALWAYS">
                        <VBox spacing="9" styleClass="panel" prefHeight="375" minHeight="375" maxHeight="375">
                            <HBox alignment="CENTER_LEFT"><Label fx:id="inputTitle" styleClass="card-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="anchorLabel" styleClass="anchor-tag"/></HBox>
                            <StackPane VBox.vgrow="ALWAYS"><Pane fx:id="waterArt" mouseTransparent="true" minWidth="0" minHeight="0" prefWidth="0" prefHeight="0"/><GridPane fx:id="crossword" alignment="CENTER" hgap="4" vgap="4"/></StackPane>
                            <Pane fx:id="sharkTrack" prefHeight="60" minHeight="60" maxHeight="60" styleClass="ocean"/>
                        </VBox>
                        <VBox spacing="6" styleClass="panel">
                            <Label fx:id="messageLabel" wrapText="true" minHeight="28" maxHeight="28" styleClass="feedback"/>
                            <VBox fx:id="keyboard" spacing="4" alignment="CENTER"/>
                            <HBox alignment="CENTER_LEFT" spacing="8" minHeight="30">
                                <Label fx:id="dictionaryLabel" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="muted"/>
                                <Button fx:id="retryButton" text="Retry lookup" onAction="#retryWord" disable="true" styleClass="small-button"/>
                            </HBox>
                        </VBox>
                    </VBox>
                    <VBox spacing="10" prefWidth="326" minWidth="326" maxWidth="326">
                        <VBox fx:id="clueACard" spacing="4" styleClass="panel"><Label fx:id="statusA" styleClass="eyebrow"/><Label fx:id="clueA" wrapText="true" styleClass="clue"/></VBox>
                        <VBox fx:id="clueBCard" spacing="4" styleClass="panel"><Label fx:id="statusB" styleClass="eyebrow"/><Label fx:id="clueB" wrapText="true" styleClass="clue"/></VBox>
                        <VBox spacing="10" styleClass="panel">
                            <Label text="THE SHIP'S GUESS LOG" styleClass="eyebrow"/>
                            <HBox spacing="18">
                                <VBox spacing="8"><Label text="A / ACROSS →" styleClass="muted"/><VBox fx:id="historyA" spacing="3"/></VBox>
                                <VBox spacing="8"><Label text="B / DOWN ↓" styleClass="muted"/><VBox fx:id="historyB" spacing="3"/></VBox>
                            </HBox>
                        </VBox>
                        <VBox spacing="7" styleClass="panel">
                            <Label text="READ THE TIDES" styleClass="eyebrow"/>
                            <Label text="Green · Right letter, right place" styleClass="legend-green"/>
                            <Label text="Gold · Right letter, another place" styleClass="legend-gold"/>
                            <Label text="Gray · No remaining letter match" styleClass="muted"/>
                            <Label text="B's five attempts are columns 1–5.&#10;Its green anchor is filled for you." styleClass="muted"/>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
            <VBox fx:id="resultPane" alignment="CENTER" spacing="20" styleClass="home" visible="false" managed="false">
                <Label text="VOYAGE COMPLETE" styleClass="badge"/>
                <Label fx:id="resultTitle" styleClass="hero-title"/>
                <Label fx:id="resultScore" styleClass="score"/>
                <Label fx:id="resultDetail" wrapText="true" maxWidth="700" styleClass="subtitle"/>
                <Label fx:id="answersLabel" styleClass="card-title"/>
                <HBox alignment="CENTER" spacing="12"><Button text="Try again" onAction="#restartLevel" styleClass="quiet-button"/><Button fx:id="nextButton" text="Next level →" onAction="#nextLevel" styleClass="primary-button"/></HBox>
                <Button text="Review your guesses" onAction="#reviewGame" styleClass="quiet-button"/>
            </VBox>
        </StackPane>
    </center>
    <bottom><HBox alignment="CENTER_LEFT" spacing="12" styleClass="footer" prefHeight="24" minHeight="24" maxHeight="24"><Label text="WORD-WRECK!" styleClass="eyebrow"/><Region HBox.hgrow="ALWAYS"/><Label text="A–Z to type · Backspace to erase · Enter to launch" styleClass="muted"/></HBox></bottom>
</BorderPane>
